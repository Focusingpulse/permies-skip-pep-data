<script>
    function safeGet(k,f){try{let d=localStorage.getItem(k);return d?JSON.parse(d):f}catch(e){return f}}function safeSet(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
    let players=safeGet('rpg_players_v41',[]);let completedQuests=safeGet('rpg_completed_v41',[]);let attendance=safeGet('rpg_attendance_v41',{days:0,hours:0,customHours:{}});let biome='apartment';let activeStudioPlayer=0;let activeStudioTab='face';let rosterSelections={};let questFilter='all';
