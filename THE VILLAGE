    const baseFaces=[{id:"🧑",name:"Person"},{id:"👧",name:"Girl"},{id:"👦",name:"Boy"},{id:"🧑‍🦱",name:"Curly"},{id:"🦉",name:"Elder"},{id:"🐺",name:"Tracker"}];
    const baseBgs=[{id:"🌳",name:"Forest"},{id:"🏡",name:"House"},{id:"🏢",name:"City"},{id:"⛰️",name:"Mountains"},{id:"🧘",name:"Studio"}];
