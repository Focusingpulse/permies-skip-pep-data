    }

    function showScreen(s){['intro','setup','village','studio','quests','school','library','commons'].forEach(x=>document.getElementById('screen-'+x).style.display='none');['setup','village','studio','quests','school','library','commons'].forEach(x=>document.getElementById('nav-'+x).classList.remove('active'));document.getElementById('screen-'+s).style.display='block';if(s!=='intro')document.getElementById('nav-'+s).classList.add('active');if(s==='setup')renderSetup();if(s==='village')renderVillage();if(s==='studio')renderStudio();if(s==='quests')renderQuests();if(s==='school')renderSchoolhouse();}
    function renderSetup(){const l=document.getElementById('player-list');l.innerHTML='';if(players.length===0)players.push({name:'Player 1',role:'tracker',stats:{tracker:0},wardrobe:[],equipped:{face:"🧑",shirt:"#4caf50",pants:"#333333",hat:null,bg:"🌳",tool:null}});players.forEach((p,i)=>{const d=document.createElement('div');d.className='player-setup';d.innerHTML=`<input type="text" placeholder="Player Name" value="${p.name}" onchange="players[${i}].name=this.value"><select onchange="players[${i}].role=this.value"><option value="tracker" ${p.role==='tracker'?'selected':''}>🏃 Tracker</option><option value="witness" ${p.role==='witness'?'selected':''}>📷 Witness</option><option value="hearth" ${p.role==='hearth'?'selected':''}>🔥 Hearth</option></select><button class="danger" onclick="players.splice(${i},1); renderSetup();">X</button>`;l.appendChild(d);});}
    function addPlayer(){if(players.length<6){players.push({name:'Player '+(players.length+1),role:'tracker',stats:{tracker:0},wardrobe:[],equipped:{face:"🧑",shirt:"#4caf50",pants:"#333333",hat:null,bg:"🌳",tool:null}});renderSetup();}}
    function saveVillage(){safeSet('rpg_players_v41',players);showScreen('village');}
    function getAvatarHTML(p,m){let c=m?'mini-avatar':'css-avatar';return `<div class="${c}">${p.equipped.hat?`<div class="avatar-hat">${p.equipped.hat}</div>`:''}<div class="avatar-head">${p.equipped.face||'🧑'}</div><div class="avatar-arms"><div class="avatar-arm" style="background:${p.equipped.shirt};"></div><div class="avatar-arm" style="background:${p.equipped.shirt};">${p.equipped.tool?`<div class="avatar-tool">${p.equipped.tool}</div>`:''}</div></div><div class="avatar-torso" style="background:${p.equipped.shirt};"></div><div class="avatar-legs"><div class="avatar-leg" style="background:${p.equipped.pants};"></div><div class="avatar-leg" style="background:${p.equipped.pants};"></div></div></div>`;}
    function renderVillage(){const l=document.getElementById('village-list');l.innerHTML='';players.forEach((p,i)=>{l.innerHTML+=`<div class="player-card" onclick="activeStudioPlayer=${i}; showScreen('studio');"><div class="mini-stage"><div class="mini-bg">${p.equipped.bg||'🌳'}</div>${getAvatarHTML(p,true)}</div><div><strong style="font-size:1.2em;">${p.name}</strong><br><span style="color:#aaa;">${p.role}</span><br><br><span style="color:#8bc34a; font-size:0.8em;"> wardrobe: ${p.wardrobe.length} items</span></div></div>`;});}
    function renderStudio(){let p=players[activeStudioPlayer];if(!p)return;document.getElementById('studio-player-name').innerText=`Customizing: ${p.name}`;document.getElementById('studio-bg-display').innerText=p.equipped.bg||'🌳';document.getElementById('studio-avatar-display').innerHTML=getAvatarHTML(p,false);renderStudioOptions();}
    function switchStudioTab(t){activeStudioTab=t;['face','clothes','bg','wardrobe'].forEach(x=>document.getElementById('tab-'+x).classList.remove('active'));document.getElementById('tab-'+t).classList.add('active');renderStudioOptions();}
    function renderStudioOptions(){let p=players[activeStudioPlayer];const a=document.getElementById('studio-options-area');a.innerHTML='';if(activeStudioTab==='face'){a.innerHTML='<div class="wardrobe-grid"></div>';const g=a.querySelector('.wardrobe-grid');baseFaces.forEach(i=>{g.innerHTML+=`<div class="wardrobe-slot ${p.equipped.face===i.id?'equipped':''}" onclick="equipItem('face','${i.id}')"><span class="slot-icon">${i.id}</span><span class="slot-name">${i.name}</span></div>`;});}else if(activeStudioTab==='clothes'){a.innerHTML='<h4>Shirt Color</h4><div class="color-palette" id="shirt-palette"></div><h4>Pants Color</h4><div class="color-palette" id="pants-palette"></div>';const sp=document.getElementById('shirt-palette');const pp=document.getElementById('pants-palette');colorPalette.forEach(c=>{sp.innerHTML+=`<div class="color-swatch ${p.equipped.shirt===c?'selected':''}" style="background:${c}" onclick="equipItem('shirt','${c}')"></div>`;pp.innerHTML+=`<div class="color-swatch ${p.equipped.pants===c?'selected':''}" style="background:${c}" onclick="equipItem('pants','${c}')"></div>`;});}else if(activeStudioTab==='bg'){a.innerHTML='<div class="wardrobe-grid"></div>';const g=a.querySelector('.wardrobe-grid');baseBgs.forEach(i=>{g.innerHTML+=`<div class="wardrobe-slot ${p.equipped.bg===i.id?'equipped':''}" onclick="equipItem('bg','${i.id}')"><span class="slot-icon">${i.id}</span><span class="slot-name">${i.name}</span></div>`;});}else if(activeStudioTab==='wardrobe'){if(p.wardrobe.length===0){a.innerHTML='<div style="text-align:center; color:#666; font-style:italic; padding:20px;">Your wardrobe is empty. Complete quests to earn hats and tools!</div>';return;}a.innerHTML='<div class="wardrobe-grid"></div>';const g=a.querySelector('.wardrobe-grid');g.innerHTML+=`<div class="wardrobe-slot ${!p.equipped.hat?'equipped':''}" onclick="equipItem('hat','null')"><span class="slot-icon">❌</span><span class="slot-name">No Hat</span></div>`;g.innerHTML+=`<div class="wardrobe-slot ${!p.equipped.tool?'equipped':''}" onclick="equipItem('tool','null')"><span class="slot-icon">❌</span><span class="slot-name">No Tool</span></div>`;p.wardrobe.forEach(i=>{let e=(p.equipped.hat===i.icon||p.equipped.tool===i.icon);g.innerHTML+=`<div class="wardrobe-slot ${e?'equipped':''}" onclick="equipWardrobeItem('${i.icon}')"><span class="slot-icon">${i.icon}</span><span class="slot-name">${i.prefix}</span></div>`;});}}
    function equipItem(t,id){let p=players[activeStudioPlayer];p.equipped[t]=id;safeSet('rpg_players_v41',players);renderStudio();}
    function equipWardrobeItem(icon){let p=players[activeStudioPlayer];let hats=["🧢","🦉","🎩"];if(hats.includes(icon)){p.equipped.hat=(p.equipped.hat===icon?null:icon);}else{p.equipped.tool=(p.equipped.tool===icon?null:icon);}safeSet('rpg_players_v41',players);renderStudio();}
    function setQuestFilter(f){questFilter=f;document.getElementById('filter-all').classList.remove('active');document.getElementById('filter-biome').classList.remove('active');document.getElementById('filter-'+f).classList.add('active');renderQuests();}
    function renderQuests(){const l=document.getElementById('quest-list');l.innerHTML='';let pep=allAspects.filter(a=>a.type==="PEP");let rpg=allAspects.filter(a=>a.type==="RPG");if(questFilter==='biome'){pep=pep.filter(a=>a.biomes.includes(biome));rpg=rpg.filter(a=>a.biomes.includes(biome));}l.innerHTML+='<div class="quest-section-header">🛡️ Official Permies PEP Quests<div class="quest-section-note">Submit evidence to their forum for official certification.</div></div>';pep.forEach((a,i)=>{l.appendChild(createGuildDetails(a,i<1));});l.innerHTML+='<div class="quest-section-header rpg">✨ Holistic RPG Add-on Guilds<div class="quest-section-note">Custom to The Village RPG. Do not count toward official Permies PEP certification.</div></div>';rpg.forEach(a=>{l.appendChild(createGuildDetails(a,false));});}
    function createGuildDetails(a,open){const d=document.createElement('details');if(open)d.open=true;const s=document.createElement('summary');s.innerHTML=`${a.type==='RPG'?'✨':'🛡️'} ${a.name} Guild`;d.appendChild(s);const c=document.createElement('div');c.className='guild-content';let h=`<div class="guild-desc">${a.desc||'No description available.'}</div>`;if(a.sand){h+='<div class="tier-header"><strong style="color:#8d6e63;">🟤 Sand Tier (Level 1)</strong></div>';a.sand.forEach(q=>{h+=renderQuestCard(a,q,'sand');});}if(a.straw){h+='<div class="tier-header" style="margin-top:15px;"><strong style="color:#ffc107;">🟡 Straw Tier (Level 2)</strong></div>';a.straw.forEach(q=>{h+=renderQuestCard(a,q,'straw');});}if(a.wood){h+='<div class="tier-header" style="margin-top:15px;"><strong style="color:#4caf50;">🟢 Wood Tier (Level 3)</strong></div>';a.wood.forEach(q=>{h+=renderQuestCard(a,q,'wood');});}if(a.iron){h+='<div class="tier-header" style="margin-top:15px;"><strong style="color:#455a64;">⚫ Iron Tier (Level 4)</strong></div>';a.iron.forEach(q=>{h+=renderQuestCard(a,q,'iron');});}c.innerHTML=h;d.appendChild(c);return d;}
    function renderQuestCard(a,q,tier){let qId=a.name.replace(/\s/g,'_').toLowerCase()+"_"+tier+"_"+q[0].replace(/\s/g,'_').toLowerCase();let isDone=completedQuests.includes(qId);let subjects=q[2].map(s=>`<span>${s}</span>`).join('');let rewardIcon=q[3]||"📦";if(!rosterSelections[qId])rosterSelections[qId]={trackers:[],witnesses:[],hearth:[]};return `<div class="quest-card ${tier}"><div style="flex:1;"><strong>${q[0]}</strong> ${isDone?'✓':''}<br><small style="color:#aaa;">${q[1]}</small><div class="subject-tags" style="margin-top:5px;">${subjects}</div>${rewardIcon!=="📦"?`<small style="color:#8bc34a; display:block; margin-top:5px;">Reward: ${rewardIcon}</small>`:''}</div><div style="text-align:right;">${isDone?'<span style="color:#4caf50; font-weight:bold;">Complete!</span>':`<button onclick="toggleRoster('${qId}')" style="width:auto; padding:8px 15px;">Finalize Quest</button>`}</div></div><div class="roster-panel" id="roster_${qId}"><div class="otis-warning"><strong>⚠️ Otis Verification Protocol:</strong><br>1. <strong>Before</strong> photo of materials/site.<br>2. <strong>During</strong> photo of you working.<br>3. <strong>After</strong> photo of finished product WITH a sign showing your name and date.</div><p style="font-size:0.8em; color:#aaa; margin-bottom:10px;">Select who participated. Multiple people can hold the same role!</p><div class="roster-row"><label>🏃 Trackers</label><div>${players.map(p=>`<button class="roster-player-btn ${rosterSelections[qId].trackers.includes(p.name)?'selected':''}" onclick="toggleRosterSel('${qId}','trackers','${p.name}')">${p.name}</button>`).join(' ')}</div></div><div class="roster-row"><label>📷 Witnesses</label><div>${players.map(p=>`<button class="roster-player-btn ${rosterSelections[qId].witnesses.includes(p.name)?'selected':''}" onclick="toggleRosterSel('${qId}','witnesses','${p.name}')">${p.name}</button>`).join(' ')}</div></div><div class="roster-row"><label>🔥 Hearth</label><div>${players.map(p=>`<button class="roster-player-btn ${rosterSelections[qId].hearth.includes(p.name)?'selected':''}" onclick="toggleRosterSel('${qId}','hearth','${p.name}')">${p.name}</button>`).join(' ')}</div></div><button class="success" style="width:auto; padding:8px 15px; margin-top:10px;" onclick="finalizeQuest('${qId}','${q[0]}','${rewardIcon}')">Confirm & Award</button></div>`;}
    function toggleRoster(qId){let p=document.getElementById('roster_'+qId);p.style.display=p.style.display==='block'?'none':'block';}
    function toggleRosterSel(qId,role,name){let arr=rosterSelections[qId][role];if(arr.includes(name)){rosterSelections[qId][role]=arr.filter(n=>n!==name);}else{arr.push(name);}renderQuests();document.getElementById('roster_'+qId).style.display='block';}
    function finalizeQuest(qId,title,icon){let sel=rosterSelections[qId];if(sel.trackers.length===0&&sel.witnesses.length===0&&sel.hearth.length===0){alert("Please assign at least one person to a role.");return;}completedQuests.push(qId);let all=[...new Set([...sel.trackers,...sel.witnesses,...sel.hearth])];all.forEach(n=>{let p=players.find(pl=>pl.name===n);if(p){if(sel.trackers.includes(n))p.stats.tracker++;if(sel.witnesses.includes(n))p.stats.witness=(p.stats.witness||0)+1;if(sel.hearth.includes(n))p.stats.hearth=(p.stats.hearth||0)+1;if(icon!=="📦"&&!p.wardrobe.some(w=>w.icon===icon)){p.wardrobe.push({id:qId,icon:icon,level:1,prefix:"Basic"});}}});safeSet('rpg_players_v41',players);safeSet('rpg_completed_v41',completedQuests);renderQuests();renderVillage();alert("Quest Finalized! Items added to the participants' wardrobes.");}
    function logDay(h=4){attendance.days+=1;attendance.hours+=h;safeSet('rpg_attendance_v41',attendance);renderSchoolhouse();}
    function addCustomHours(){let s=document.getElementById('custom-subj').value;let h=parseInt(document.getElementById('custom-hrs').value);if(!h||h<1)return alert("Enter a valid number of hours.");if(!attendance.customHours)attendance.customHours={};attendance.customHours[s]=(attendance.customHours[s]||0)+h;attendance.hours+=h;safeSet('rpg_attendance_v41',attendance);renderSchoolhouse();document.getElementById('custom-hrs').value='';}
    function renderSchoolhouse(){document.getElementById('att-days').innerText=attendance.days;document.getElementById('att-hours').innerText=attendance.hours;document.getElementById('att-bar').style.width=(attendance.days/172*100)+"%";document.getElementById('att-hours-bar').style.width=(attendance.hours/688*100)+"%";let tr={"Reading":0,"Writing":0,"Math":0,"Science":0,"History":0,"Geography":0,"Constitution":0,"Economics":0,"PE":0,"Health":0,"Art":0};completedQuests.forEach(qId=>{allAspects.forEach(a=>{['sand','straw','wood','iron'].forEach(t=>{if(a[t]){a[t].forEach(q=>{let cId=a.name.replace(/\s/g,'_').toLowerCase()+"_"+t+"_"+q[0].replace(/\s/g,'_').toLowerCase();if(qId===cId){q[2].forEach(s=>{if(tr[s]!==undefined)tr[s]+=2;});}});}});});});if(attendance.customHours){Object.keys(attendance.customHours).forEach(s=>{if(tr[s]!==undefined)tr[s]+=attendance.customHours[s];});}const l=document.getElementById('transcript-list');l.innerHTML='';Object.keys(tr).forEach(s=>{l.innerHTML+=`<div class="stat-row"><span><strong>${s}:</strong> ${tr[s]} Hours</span><div class="progress-bar"><div class="progress-fill" style="width:${Math.min(tr[s]/50*100,100)}%"></div></div></div>`;});}
    showScreen('intro');
</script>
</body>
</html>
